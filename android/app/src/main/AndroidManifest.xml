<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ 权限声明（避坑指南 1：缺一不可） ============ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 前台服务：后台播放的基石 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 前台服务必须细分类型：媒体播放 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- CPU 唤醒锁：锁屏后维持音频流 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 13+ 通知栏媒体控制需要运行时申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 应用内更新：下载 APK 后拉起系统安装器（Android 8+ 允许安装未知来源） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 封面保存至相册（仅 Android 9- 公共目录写入需要；10+ 走 MediaStore 免权限） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- ============ 本地音乐（MediaStore 音频库读取） ============ -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- ============ 媒体输出（发现附近设备，仿网易云投屏） ============ -->
    <!-- Android 12+：蓝牙扫描/连接 -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 13+：发现附近设备（WLAN/局域网设备发现） -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Android 11-：蓝牙/局域网设备发现需要定位权限 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:label="MingMusic"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 一起听邀请深链（第二十五批）：mingmusic://listen/join?roomId=X&inviterId=Y
                 好友点击分享链接直接拉起 App 加入房间；浏览器/备忘录/短信内可点 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mingmusic" android:host="listen" />
            </intent-filter>
        </activity>

        <!-- 灰屏修复（2026-10）：Impeller OpenGLES 后端在部分老 GPU
             （vivo/MTK + Android 12 实证灰屏）上存在渲染异常，回退 Skia。
             Skia 为 Flutter 长期默认后端，兼容性最优。 -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />

        <!-- 双保险：若将来重新启用 Impeller（EnableImpeller 改 true），
             强制使用 OpenGLES 后端 —— 老麒麟（Mali-G51）的 Vulkan 驱动
             存在首帧无法上屏的兼容性问题，绝不使用 Vulkan 后端。 -->
        <meta-data
            android:name="io.flutter.embedding.android.ImpellerBackend"
            android:value="opengles" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- ============ audio_service：通知栏媒体控制 ============ -->
        <!-- 避坑指南 1：Android 14+ 必须显式声明 foregroundServiceType="mediaPlayback"，
             否则启动前台服务直接崩溃 (MissingForegroundServiceTypeException)。 -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- 媒体按钮（耳机线控 / 蓝牙按键）接收器 -->
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
